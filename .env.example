# ============================================================
# MOBEUV — variáveis de ambiente
# Copie este arquivo para `.env.local` e ajuste os valores.
# ============================================================

# Subdiretório em que o site será servido.
# Domínio próprio (https://mobeuv.com): deixe vazio.
# GitHub Pages (site de projeto): "/morty" (nome do repositório)
NEXT_PUBLIC_BASE_PATH=

# URL pública completa do site (usada em SEO / Open Graph / canonical).
NEXT_PUBLIC_SITE_URL=https://mobeuv.com

# E-mail institucional usado no formulário de contato (fallback via mailto:)
# e exibido na seção de contato / rodapé.
NEXT_PUBLIC_CONTACT_EMAIL=app@mobeuv.com
